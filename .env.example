# ===== Database =====
# The app and the seed scripts use this one. The test suite does not: it
# creates its own throwaway sibling (hotel_mp_test) and drops it when the run
# ends, so pytest can no longer wipe the demo content a re-seed puts back.
# See tests/conftest.py; scripts/mk_test_db.py provisions that database where
# it has to exist before some other step runs.
DATABASE_URL=postgresql://hotel_user:hotel_pass@localhost:5432/hotel_mp

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# Docker Compose variables. Leave POSTGRES_PASSWORD empty here and set a
# generated value in .env before deploying.
POSTGRES_USER=hotel_user
POSTGRES_DB=hotel_mp
POSTGRES_PASSWORD=

# ===== App =====
# local for development. Anything else, and the default when unset, is production:
# startup then refuses the placeholder JWT_SECRET, an invalid WEBHOOK_SEAL_KEY,
# ALLOW_PRIVATE_TARGETS, a non-https APP_BASE_URL and the test-only payment modes.
APP_ENV=local
APP_HOST=0.0.0.0
# Port 8000 is taken by another project on this machine, so the default dev
# port here is 8002. The frontend dev proxy follows it (web/.env.local).
APP_PORT=8002
# Public origin used to build partner-facing URLs (the iCal feed address).
APP_BASE_URL=http://localhost:8002
LOG_LEVEL=debug
# Compose disables jobs in web workers and enables them in the dedicated jobs service.
RUN_BACKGROUND_JOBS=true
# Container runtime: host port, Uvicorn worker count, and trusted reverse-proxy peers.
WEB_PORT=8000
WEB_CONCURRENCY=2

# ===== Outbound URLs partners control =====
# Webhook receivers and iCal feeds are requested by our servers, so URLs that point at
# private, loopback or link-local addresses are refused. Set to true only on a developer
# machine, to try a webhook against localhost.
ALLOW_PRIVATE_TARGETS=false

# ===== Sealing =====
# Key that seals webhook subscription secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes every existing secret unreadable.
WEBHOOK_SEAL_KEY=
# The outgoing key, only during a rotation: keep it here + put the new one in
# WEBHOOK_SEAL_KEY, run scripts/rotate_seal_key.py, and drop this entry once
# the script reports nothing left on the old key. Empty except during a rotation.
WEBHOOK_SEAL_KEY_PREVIOUS=

# ===== Rate limits (attempts per client address per minute) =====
# Logins, registrations and booking lookups take guesses, so they are throttled.
# One account or booking code gets 3x this across all addresses. Raise these if many
# users share one address; 0 blocks the endpoint outright (there is no "off").
# "Client address" is what uvicorn reports. It reads X-Forwarded-For only from the peers
# in --forwarded-allow-ips (or the FORWARDED_ALLOW_IPS environment variable of the uvicorn
# process, not a setting read from this file), default 127.0.0.1,::1. A proxy on the same
# host works as is; one on another host must be listed there, or every user shares the
# proxy's bucket. Do not use '*' unless only the proxy can reach the app: anyone could
# then forge an address and skip the per-address limit.
# Container entrypoint only trusts X-Forwarded-For from these Uvicorn peers.
FORWARDED_ALLOW_IPS=127.0.0.1
LOGIN_LIMIT_PER_MIN=10
REGISTER_LIMIT_PER_MIN=5
LOOKUP_LIMIT_PER_MIN=10
# Expensive endpoints, per client address per window. A hold takes inventory for 15 minutes,
# so unthrottled one script could lock every room.
HOLD_LIMIT_PER_MIN=20
AVAILABILITY_LIMIT_PER_MIN=120
SEARCH_LIMIT_PER_MIN=240
PHOTO_UPLOAD_LIMIT_PER_MIN=20
ICAL_SYNC_LIMIT_PER_MIN=6

# ===== Auth / JWT =====
# Outside local/dev/test the app refuses to start with the placeholder or a secret
# shorter than 32 characters: generate one with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=CHANGE_ME_SUPER_SECRET_32_PLUS_CHARS_LONG
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=60

# ===== Booking core =====
HOLD_TTL_MIN=15

# ===== Payment (stub by default — see app/config/payment.py) =====
PAYMENT_MODE=stub

# ===== Telegram bot (partner notifications, optional) =====
TELEGRAM_BOT_TOKEN=

# ===== Sentry (optional) =====
SENTRY_DSN=
