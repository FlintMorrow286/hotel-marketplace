# Git
.git

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Env
# web/.env.local is the dev proxy port template, not a secret: keep it tracked
# so a fresh clone proxies to the right API without a manual setup step.
# .env.example is the backend template for the same reason.
.env
.env.*
!.env.example
!web/.env.local
# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Node (web)
web/node_modules/
web/dist/

# Node build artifacts of the frontend
web/.vite/

# Partner photo uploads (come through the API, never copied in)
media/

# Scratch Tailwind playground (not part of the app)
web/.twtest/
web/test-results/
web/playwright-report/

# TypeScript incremental build cache
web/tsconfig.tsbuildinfo
